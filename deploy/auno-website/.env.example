SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
AUNO_PUBLIC_ORIGIN=https://auno.cash
# Public Devnet split settlement remains disabled until the full acceptance matrix passes.
AUNO_DEVNET_SPLITS_ENABLED=false
AUNO_VERIFIER_BATCH_SIZE=25
AUNO_VERIFIER_POLL_MS=30000
# Generate at least 32 random characters. Server-only; never expose it to the browser.
AUNO_VERIFIER_TOKEN=
# Mainnet Beta is a separate deployment (Cloudflare Worker + D1, or Coolify compose.mainnet.yaml).
# Keep these disabled in every Devnet and local environment.
# AUNO_MAINNET_ENABLED=false
# Coolify Mainnet gates enforced by docker-entrypoint.sh. Set exactly one, never both.
# AUNO_COOLIFY_MAINNET_STAGING=true      # settlement-disabled staging on Coolify
# AUNO_COOLIFY_MAINNET_PRODUCTION=true   # settlement-enabled production on Coolify
# Comma-separated approved Mainnet merchant wallets; server-only deployment configuration.
# AUNO_ALLOWED_MERCHANTS=
# Keep Mainnet split settlement disabled until the canary gates pass.
# AUNO_MAINNET_SPLITS_ENABLED=false
# Mainnet USDC kill switch; USDC is enabled unless this is explicitly "false".
# AUNO_MAINNET_USDC_ENABLED=true
# AUNO_MAX_SOL_LAMPORTS=100000000
# Mainnet USDC per-link cap in base units (100000000 = 100 USDC at 6 decimals).
# AUNO_MAX_USDC_BASE_UNITS=100000000
# AUNO_VERIFIER_BATCH_SIZE=25
# AUNO_VERIFIER_TOKEN=
# Server-only RPC endpoint. No private keys or seed phrases are used.
