SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
AUNO_PUBLIC_ORIGIN=https://auno.cash
# Mainnet Beta is a separate Cloudflare Worker + managed D1 deployment.
# Keep these disabled in every Devnet and local environment.
# AUNO_MAINNET_ENABLED=false
# AUNO_ALLOWED_MERCHANTS=
# AUNO_MAX_SOL_LAMPORTS=100000000
# AUNO_VERIFIER_BATCH_SIZE=25
# AUNO_VERIFIER_TOKEN=
# Server-only RPC endpoint. No private keys or seed phrases are used.
